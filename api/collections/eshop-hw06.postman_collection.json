        {
          "name": "POST /api/checkout (data-driven)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.upsert({ key: 'X-Student-Id', value: '23127300' });",
                  "const row = pm.iterationData.toObject();",
                  "const m = row.authMode;",
                  "pm.request.headers.remove('Authorization');",
                  "if (m === 'user') pm.request.headers.add({key:'Authorization', value:'Bearer ' + pm.environment.get('userToken')});",
                  "if (m === 'invalid') pm.request.headers.add({key:'Authorization', value:'Bearer not.a.real.token'});",
                  "const body = {};",
                  "if (row.total_amount !== null && row.total_amount !== undefined) body.total_amount = row.total_amount;",
                  "if (row.shipping_address !== null && row.shipping_address !== undefined) body.shipping_address = row.shipping_address;",
                  "pm.request.body.raw = JSON.stringify(body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const row = pm.iterationData.toObject();",
                  "if (row.knownBug) {",
                  "  pm.test(`[known-bug] ${row._desc}: observed ${pm.response.code}`, () => true);",
                  "} else if (row.expectSchema) {",
                  "  pm.test(`${row._desc}: 200`, () => pm.response.to.have.status(200));",
                  "  pm.test(`${row._desc}: schema match`, () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json).to.have.property('orderId');",
                  "    pm.expect(json.orderId).to.be.a('number');",
                  "  });",
                  "  if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('lastOrderId', json.orderId);",
                  "  }",
                  "} else {",
                  "  pm.test(`${row._desc}: rejected (expected ${row.expectStatus})`, () => pm.expect(pm.response.code).to.eql(row.expectStatus));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
