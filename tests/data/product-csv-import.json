      "expectedNames": ["FR16-{runId}-WrongHeader"],
      "expectedErrorPattern": "header|tiêu đề|cột"
    },
    {
      "id": "TC-CSV-013",
      "title": "Không import file CSV rỗng",
      "scenario": "noRows",
      "fileName": "empty.csv",
      "csv": "",
      "expectedPreviewRows": 0
    },
    {
      "id": "TC-CSV-014",
      "title": "Không import file chỉ có header",
      "scenario": "noRows",
      "fileName": "header-only.csv",
      "csv": "name,price,description,imageUrl,category_id",
      "expectedPreviewRows": 0
    },
    {
      "id": "TC-CSV-015",
      "title": "Báo cáo đủ số dòng thành công lỗi và lý do",
