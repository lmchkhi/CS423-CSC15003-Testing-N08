      "fileName": "nonnumeric-price.csv",
      "csv": "name,price,description,imageUrl,category_id\nFR16-{runId}-BeforeText,150000,Hợp lệ,https://example.com/ok.png,1\nFR16-{runId}-Text,abc,Giá chữ,https://example.com/text.png,1",
      "expectedNames": ["FR16-{runId}-BeforeText", "FR16-{runId}-Text"],
      "expectedErrorPattern": "giá|price|số",
      "expectedErrorRows": 1
    },
    {
      "id": "TC-CSV-011",
      "title": "Rollback khi thiếu price",
      "scenario": "validationRollback",
      "fileName": "missing-price.csv",
      "csv": "name,price,description,imageUrl,category_id\nFR16-{runId}-BeforeNoPrice,150000,Hợp lệ,https://example.com/ok.png,1\nFR16-{runId}-NoPrice,,Thiếu giá,https://example.com/no-price.png,1",
      "expectedNames": ["FR16-{runId}-BeforeNoPrice", "FR16-{runId}-NoPrice"],
      "expectedErrorPattern": "giá|price|số",
      "expectedErrorRows": 1
    },
    {
      "id": "TC-CSV-012",
      "title": "Từ chối header không đúng đặc tả",
      "scenario": "invalidHeader",
      "fileName": "wrong-header.csv",
