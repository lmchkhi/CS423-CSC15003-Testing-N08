            <stringProp name="parameters"></stringProp>
            <stringProp name="script"><![CDATA[import groovy.json.JsonOutput
vars.put('checkoutBody', JsonOutput.toJson([total_amount: new BigDecimal(vars.get('totalAmount')), shipping_address: vars.get('shippingAddress')]))]]></stringProp>
