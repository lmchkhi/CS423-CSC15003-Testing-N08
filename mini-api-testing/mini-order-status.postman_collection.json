    {
      "name": "00 Setup - Login as admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  pm.test(\"[MINI] Setup: login admin returns 200\", function () {",
              "    pm.response.to.have.status(200);",
              "  });",
              "",
              "  pm.test(\"[MINI] Setup: login admin returns a JWT token\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"token\").that.is.a(\"string\").and.not.empty;",
              "    pm.collectionVariables.set(\"adminToken\", body.token);",
              "  });",
              "})();"
            ]
          }
        }
      ],
