              "",
              "  // EXT-03 - assertion tu bo sung o Buoc 3: xac nhan trang thai da that su duoc ghi",
              "  // xuong (hoac khong bi thay doi khi request bi tu choi).",
              "  pm.test(`[MINI][${tc}] Functional: persisted order status is \"${expectedFinal}\"`, function () {",
              "    pm.expect(pm.response.json().status).to.eql(expectedFinal);",
              "  });",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}"
          ]
        },
        "description": "Doc lai don hang de xac nhan trang thai da persist dung (hoac khong doi)."
      },
      "response": []
