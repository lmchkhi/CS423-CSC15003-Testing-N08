    {
      "name": "02 Setup - Create a fresh order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  pm.test(\"[MINI] Setup: checkout creates a fresh order (200)\", function () {",
              "    pm.response.to.have.status(200);",
              "  });",
              "",
              "  pm.test(\"[MINI] Setup: checkout returns an orderId\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"orderId\").that.is.a(\"number\");",
              "    pm.collectionVariables.set(\"orderId\", String(body.orderId));",
              "  });",
              "})();"
            ]
          }
        }
      ],
