    {
      "name": "03 Setup - Move order to precondition state",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  // Chi chay khi test case can dua don hang ve mot trang thai khac \"pending\".",
              "  const pre = pm.iterationData.get(\"precondition_status\");",
              "  if (!pre) {",
              "    pm.execution.skipRequest();",
              "  }",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  pm.test(\"[MINI] Setup: precondition transition applied (200)\", function () {",
              "    pm.response.to.have.status(200);",
              "  });",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"{{precondition_status}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/orders/{{orderId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "orders",
            "{{orderId}}",
            "status"
          ]
        },
        "description": "Bi skip khi cot precondition_status trong data file de trong."
      },
      "response": []
    },
    {
      "name": "04 SUT - PUT /api/admin/orders/:id/status",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const data = pm.iterationData;",
              "",
              "  // 1) Chon order id: mac dinh la don vua tao, hoac gia tri override cua test case.",
              "  const override = data.get(\"order_id_override\");",
              "  pm.collectionVariables.set(",
              "    \"targetOrderId\",",
              "    override ? String(override) : pm.collectionVariables.get(\"orderId\"),",
              "  );",
              "",
              "  // 2) Gan Authorization theo cot \"auth\" cua data file (admin | customer | none).",
              "  pm.request.headers.remove(\"Authorization\");",
              "  const auth = data.get(\"auth\");",
              "  if (auth === \"admin\") {",
              "    pm.request.headers.upsert({",
              "      key: \"Authorization\",",
              "      value: \"Bearer \" + pm.collectionVariables.get(\"adminToken\"),",
              "    });",
              "  } else if (auth === \"customer\") {",
              "    pm.request.headers.upsert({",
              "      key: \"Authorization\",",
              "      value: \"Bearer \" + pm.collectionVariables.get(\"customerToken\"),",
              "    });",
              "  }",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(function () {",
              "  const data = pm.iterationData;",
              "  const tc = data.get(\"tc_id\");",
              "  const expectedStatus = Number(data.get(\"expected_status\"));",
              "  const expectedError = data.get(\"expected_error\");",
              "  const expectedMessage = data.get(\"expected_message\");",
              "",
              "  const successSchema = {",
              "    type: \"object\",",
              "    required: [\"message\"],",
              "    properties: { message: { type: \"string\" } },",
              "    additionalProperties: true,",
              "  };",
              "",
              "  const errorSchema = {",
              "    type: \"object\",",
              "    required: [\"error\"],",
              "    properties: { error: { type: \"string\" } },",
              "    additionalProperties: true,",
              "  };",
              "",
              "  pm.test(`[MINI][${tc}] Functional: status code is ${expectedStatus}`, function () {",
              "    pm.response.to.have.status(expectedStatus);",
              "  });",
              "",
              "  // EXT-01 - assertion tu bo sung o Buoc 3.",
              "  pm.test(`[MINI][${tc}] Contract: Content-Type is application/json`, function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(",
              "      \"application/json\",",
              "    );",
              "  });",
              "",
              "  // EXT-02 - assertion tu bo sung o Buoc 3.",
              "  pm.test(`[MINI][${tc}] Functional: response time is under 1000ms`, function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "  });",
              "",
              "  pm.test(`[MINI][${tc}] Contract: body matches the documented JSON schema`, function () {",
              "    const schema = expectedStatus === 200 ? successSchema : errorSchema;",
              "    pm.response.to.have.jsonSchema(schema);",
              "  });",
              "",
              "  pm.test(`[MINI][${tc}] Functional: body carries the expected message`, function () {",
              "    const body = pm.response.json();",
              "    if (expectedStatus === 200) {",
              "      pm.expect(body.message).to.eql(expectedMessage);",
              "    } else {",
              "      pm.expect(body.error).to.eql(expectedError);",
              "    }",
              "  });",
              "})();"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"{{request_status}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/admin/orders/{{targetOrderId}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "admin",
            "orders",
            "{{targetOrderId}}",
            "status"
          ]
        },
        "description": "Request chinh cua bai. Order id, token va body deu lay tu iteration data."
      },
      "response": []
    },
