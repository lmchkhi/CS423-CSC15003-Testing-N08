{
	"info": {
		"_postman_id": "mini-products-collection",
		"name": "Mini Products API Test",
		"description": "API Testing collection for GET /api/products endpoint with data-driven test cases.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "GET Products",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Set X-Student-Id header from environment variable",
							"pm.request.headers.upsert({",
							"    key: \"X-Student-Id\",",
							"    value: pm.environment.get(\"studentId\")",
							"});",
							"",
							"// Build URL based on data file variables",
							"let baseUrl = pm.environment.get(\"baseUrl\");",
							"let url = baseUrl + \"/api/products\";",
							"",
							"if (pm.iterationData.get(\"use_search\") === true) {",
							"    let searchQuery = pm.iterationData.get(\"search_query\");",
							"    url += \"?search=\" + encodeURIComponent(searchQuery);",
							"}",
							"",
							"pm.request.url = url;",
							"",
							"console.log(`[${pm.iterationData.get(\"tc_id\")}] Request URL: ${url}`);"
						]
					}
				},
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Get test case data from iteration data file",
							"const tcId = pm.iterationData.get(\"tc_id\");",
							"const description = pm.iterationData.get(\"description\");",
							"const expectedStatus = pm.iterationData.get(\"expected_status\");",
							"const expectedIsArray = pm.iterationData.get(\"expected_is_array\");",
							"const expectedMinLength = pm.iterationData.get(\"expected_min_length\");",
							"const checkNameContains = pm.iterationData.get(\"check_name_contains\");",
							"const expectedNameContains = pm.iterationData.get(\"expected_name_contains\");",
							"",
							"// Test 1: Status code matches expected",
							"pm.test(`[${tcId}] Status code is ${expectedStatus} - ${description}`, () => {",
							"    pm.response.to.have.status(expectedStatus);",
							"});",
							"",
							"// Test 2: Response is JSON (Content-Type validation - EXT-01)",
							"pm.test(`[${tcId}] Response is JSON (Content-Type)`, () => {",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
							"});",
							"",
							"// Test 3: Response time < 2000ms (EXT-02)",
							"pm.test(`[${tcId}] Response time < 2000ms`, () => {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"// Test 4: Response body is an array",
							"if (expectedIsArray) {",
							"    pm.test(`[${tcId}] Response body is an array`, () => {",
							"        const jsonData = pm.response.json();",
							"        pm.expect(jsonData).to.be.an(\"array\");",
							"    });",
							"}",
							"",
							"// Test 5: Array length matches expected minimum",
							"pm.test(`[${tcId}] Array length >= ${expectedMinLength}`, () => {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData.length).to.be.at.least(expectedMinLength);",
							"});",
							"",
							"// Test 6: Check name contains keyword (if applicable)",
							"if (checkNameContains && expectedNameContains) {",
							"    pm.test(`[${tcId}] All results contain '${expectedNameContains}' in name`, () => {",
							"        const jsonData = pm.response.json();",
							"        jsonData.forEach(item => {",
							"            pm.expect(item.name.toLowerCase()).to.include(expectedNameContains.toLowerCase());",
							"        });",
							"    });",
							"}",
							"",
							"// Test 7: Schema validation (check fields exist for non-empty results)",
							"pm.test(`[${tcId}] Schema validation - required fields`, () => {",
							"    const jsonData = pm.response.json();",
							"    if (jsonData.length > 0) {",
							"        const firstItem = jsonData[0];",
							"        pm.expect(firstItem).to.have.property(\"id\");",
							"        pm.expect(firstItem).to.have.property(\"name\");",
							"        pm.expect(firstItem).to.have.property(\"price\");",
							"        pm.expect(firstItem).to.have.property(\"description\");",
							"        pm.expect(firstItem).to.have.property(\"imageUrl\");",
							"        pm.expect(firstItem).to.have.property(\"category_id\");",
							"    }",
							"});",
							"",
							"// Log for debugging",
							"console.log(`[${tcId}] Response status: ${pm.response.code}`);",
							"console.log(`[${tcId}] Response body length: ${pm.response.json().length}`);"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/products",
					"host": ["{{baseUrl}}"],
					"path": ["api", "products"]
				}
			}
		}
	]
}
