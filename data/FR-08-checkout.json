{
  "feature": "FR-08",
  "baseURL": "http://localhost:3000",
  "product": {
    "id": 4,
    "name": "Tai nghe AirPods Pro 2",
    "price": 6000000,
    "quantity": 2
  },
  "addresses": {
    "valid": "123 Le Loi, Q1, TP.HCM",
    "default": "456 Nguyen Hue, Q1, TP.HCM",
    "xss": "<script>alert('xss')</script>",
    "sql": "'; DROP TABLE orders;--"
  },
  "cases": [
    {
      "id": "TC-FR08-BVA-001",
      "title": "Bỏ qua tổng client -1",
      "type": "edge",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": -1, "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "valid", "orderStatus": "pending" },
      "source": "HW02",
      "tags": ["@fr08", "@bva", "@edge", "root-cause:client-total-trusted"]
    },
    {
      "id": "TC-FR08-DT-001",
      "title": "Checkout hợp lệ và xóa giỏ",
      "type": "positive",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": 12000000, "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "valid", "orderStatus": "pending", "cartCountAfter": 0 },
      "source": "HW02",
      "tags": ["@fr08", "@positive", "related:TC-FR08-DT-015", "root-cause:cart-not-cleared"]
    },
    {
      "id": "TC-FR08-DT-002",
      "title": "Checkout thiếu token",
      "type": "negative",
      "preconditions": ["Không đăng nhập"],
      "input": { "authMode": "missing", "cartState": "empty", "totalAmount": 12000000, "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 401, "orderCreated": false },
      "source": "HW02",
      "tags": ["@fr08", "@negative", "@auth"]
    },
    {
      "id": "TC-FR08-DT-003",
      "title": "Checkout với invalid token",
      "type": "negative",
      "preconditions": ["Token cố ý không hợp lệ"],
      "input": { "authMode": "invalid", "cartState": "empty", "totalAmount": 12000000, "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 403, "orderCreated": false },
      "source": "HW02",
      "tags": ["@fr08", "@negative", "@auth"]
    },
    {
      "id": "TC-FR08-DT-004",
      "title": "Bỏ qua tổng client bằng 1",
      "type": "edge",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": 1, "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "valid", "orderStatus": "pending" },
      "source": "HW02",
      "tags": ["@fr08", "@edge", "related:TC-FR08-BVA-003", "root-cause:client-total-trusted"]
    },
    {
      "id": "TC-FR08-DT-005",
      "title": "Bỏ qua tổng client bằng 0",
      "type": "edge",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": 0, "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "valid", "orderStatus": "pending" },
      "source": "HW02",
      "tags": ["@fr08", "@edge", "related:TC-FR08-BVA-002", "root-cause:client-total-trusted"]
    },
    {
      "id": "TC-FR08-DT-006",
      "title": "Bỏ qua tổng client âm -50000",
      "type": "negative",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": -50000, "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "valid", "orderStatus": "pending" },
      "source": "HW02",
      "tags": ["@fr08", "@negative", "@security", "root-cause:client-total-trusted"]
    },
    {
      "id": "TC-FR08-DT-007",
      "title": "Bỏ qua tổng client quá cao",
      "type": "negative",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": 99999999, "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "valid", "orderStatus": "pending" },
      "source": "HW02",
      "tags": ["@fr08", "@negative", "@security", "root-cause:client-total-trusted"]
    },
    {
      "id": "TC-FR08-DT-008",
      "title": "Backend tự tính khi thiếu total_amount",
      "type": "edge",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "omitTotalAmount": true, "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "valid", "orderStatus": "pending" },
      "source": "HW02",
      "tags": ["@fr08", "@edge", "root-cause:client-total-trusted"]
    },
    {
      "id": "TC-FR08-DT-009",
      "title": "Backend bỏ qua string NaN",
      "type": "negative",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": "NaN", "shippingAddressKey": "valid" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "valid", "orderStatus": "pending" },
      "source": "HW02",
      "tags": ["@fr08", "@negative", "@type-validation", "root-cause:client-total-trusted"]
    },
    {
      "id": "TC-FR08-DT-010",
      "title": "Reject địa chỉ rỗng khi không có mặc định",
      "type": "negative",
      "preconditions": ["User role user cô lập", "Hồ sơ không có địa chỉ mặc định", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": 12000000, "shippingAddress": "" },
      "expected": { "responseOk": false, "orderCreated": false },
      "source": "HW02",
      "tags": ["@fr08", "@negative", "@address"]
    },
    {
      "id": "TC-FR08-DT-011",
      "title": "Dùng địa chỉ mặc định khi thiếu shipping_address",
      "type": "edge",
      "preconditions": ["User role user cô lập", "Hồ sơ có địa chỉ mặc định", "Giỏ có AirPods Pro 2 x2"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": 12000000, "omitShippingAddress": true, "profileDefaultAddressKey": "default" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "default", "orderStatus": "pending" },
      "source": "HW02",
      "tags": ["@fr08", "@edge", "@address", "root-cause:default-address-not-used"]
    },
    {
      "id": "TC-FR08-DT-012",
      "title": "Lưu payload XSS như dữ liệu tại checkout API",
      "type": "negative",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2", "Phạm vi FR-08 API-only đã duyệt"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": 12000000, "shippingAddressKey": "xss" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "xss", "orderStatus": "pending" },
      "source": "HW02",
      "tags": ["@fr08", "@negative", "@xss", "@api-only"]
    },
    {
      "id": "TC-FR08-DT-013",
      "title": "Lưu SQL payload dạng plain text",
      "type": "negative",
      "preconditions": ["User role user cô lập", "Giỏ có AirPods Pro 2 x2", "SUT localhost là môi trường test"],
      "input": { "authMode": "valid", "cartState": "filled", "totalAmount": 12000000, "shippingAddressKey": "sql" },
      "expected": { "responseStatus": 200, "orderCreated": true, "orderTotal": 12000000, "orderAddressKey": "sql", "orderStatus": "pending", "ordersApiStatusAfter": 200 },
      "source": "HW02",
      "tags": ["@fr08", "@negative", "@sql-injection", "@local-test-only"]
    },
    {
      "id": "TC-FR08-DT-014",
      "title": "Reject checkout khi giỏ trống",
      "type": "negative",
      "preconditions": ["User role user cô lập", "Giỏ được xác nhận rỗng"],
      "input": { "authMode": "valid", "cartState": "empty", "totalAmount": 12000000, "shippingAddressKey": "valid" },
      "expected": { "responseOk": false, "orderCreated": false },
      "source": "HW02",
      "tags": ["@fr08", "@negative", "@empty-cart", "root-cause:empty-cart-checkout-accepted"]
    }
  ]
}
