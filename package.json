{
  "name": "cs423-eshop-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint tests/**/*.ts playwright.config.ts playwright.fr12.config.ts",
    "typecheck": "tsc --noEmit",
    "test:fr08": "playwright test tests/FR-08-checkout.spec.ts",
    "test:fr12": "playwright test tests/fr12-access.spec.ts --project=chromium --reporter=list --output=test-results/fr12-phase-c",
    "test:fr12:phase-d": "playwright test tests/fr12-access.spec.ts --config=playwright.fr12.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.12.2",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "eslint": "9.39.4",
    "typescript": "5.9.3"
  }
}
