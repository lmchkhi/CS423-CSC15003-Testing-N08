{
  "info": {
    "name": "HW06 CI Smoke API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: pm.environment.get('studentId') || '23127475' });",
          "console.log('[HW06-CI] ' + pm.info.requestName + ' X-Student-Id=' + (pm.environment.get('studentId') || '23127475'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "CI-SMOKE-001 - Products endpoint is available",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response is JSON', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'));",
              "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "CI-SMOKE-002 - Admin login returns token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('token exists', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
              "pm.test('user role is admin', () => pm.expect(json.user && json.user.role).to.equal('admin'));",
              "pm.environment.set('adminToken', json.token || '');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@eshop.com\",\"password\":\"Admin123!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      }
    },
    {
      "name": "CI-SMOKE-003 - User login returns token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('token exists', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
              "pm.test('user role is user', () => pm.expect(json.user && json.user.role).to.equal('user'));",
              "pm.environment.set('userToken', json.token || '');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"test@eshop.com\",\"password\":\"Test1234!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      }
    },
    {
      "name": "CI-SMOKE-004 - Coupon list works with admin token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + (pm.environment.get('adminToken') || '') });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('response is JSON', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'));",
              "pm.test('response is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Student-Id",
            "value": "{{studentId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/coupons",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "coupons"
          ]
        }
      }
    }
  ]
}
